      "category": "正常",
      "question": "传感器校准失败后应该检查什么？",
      "should_answer": true,
      "risk_level": "high",
      "retrieval_passed": true,
      "top1_score": 0.782683,
      "retrieved_sources": [
        "历史故障案例.txt",
